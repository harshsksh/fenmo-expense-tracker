generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Category {
  Food
  Transport
  Shopping
  Bills
  Health
  Entertainment
  Other
}

model Expense {
  id          String   @id
  amount      Int
  category    Category
  description String
  date        String
  created_at  DateTime @default(now())

  @@index([category])
  @@index([date])
}
